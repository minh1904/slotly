{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "next": "recommended",
      "react": "recommended"
    },
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedImports": "error"
      },
      "style": {
        "useImportType": "error"
      },
      "nursery": {
        "useSortedClasses": {
          "level": "error",
          "fix": "safe",
          "options": {
            "attributes": ["className", "classList"],
            "functions": ["cn", "clsx", "cva", "tw"]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/app/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/**/data"],
                    "message": "Pages and layouts read through features/<domain>/loaders.ts, never data.ts directly — the loader owns the auth gate."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/components/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/**"],
                    "message": "components/ is domain-agnostic UI and must not depend on features/. Domain UI belongs in features/<domain>/components/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/**", "@/components/**"],
                    "message": "lib/ is the bottom layer (app -> features -> components -> lib) and must not import features/ or components/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/**/data.ts", "src/features/**/mutations.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "next/headers": "data.ts/mutations.ts trust their input and never read session/request. Session-aware reads belong in loaders.ts, auth in actions.ts.",
                  "next/navigation": "data.ts/mutations.ts never redirect. Page semantics belong in loaders.ts or the route."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/features/**",
        "!src/features/**/components/**",
        "!src/features/**/assets/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "warn",
              "options": {
                "match": "(?:data|loaders|mutations|actions|schema|types|constants|utils|service)[.]ts|client[.]tsx|.+[.]test[.]tsx?",
                "filenameCases": ["kebab-case"]
              }
            }
          }
        }
      }
    }
  ]
}
